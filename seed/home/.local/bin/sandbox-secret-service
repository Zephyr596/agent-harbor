#!/bin/sh
# Run only the Secret Service components inside the persistent Debian app layer.
set -eu
ROOT=/config/proot-apps/ghcr.io_linuxserver_proot-apps_claude
case "${1:-}" in
  daemon) set -- /usr/bin/gnome-keyring-daemon --foreground --components=secrets ;;
  prompt) set -- /usr/libexec/gcr-prompter ;;
  *) echo "Usage: sandbox-secret-service daemon|prompt" >&2; exit 2 ;;
esac
export GDK_BACKEND=x11
exec /config/.local/bin/proot -R "$ROOT" "$@"

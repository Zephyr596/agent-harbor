#!/usr/bin/env python3
"""Reopen installed desktop apps once; i3 assigns their fixed workspaces."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import socket
import subprocess
import time

APPS = (
    {"name": "chrome", "class": "Google-chrome", "process": "chrome",
     "launcher": "sandbox-browser", "args": ["--restore-last-session"]},
    {"name": "claude", "class": "com.anthropic.Claude", "process": "claude-desktop",
     "launcher": "sandbox-claude-desktop", "args": []},
)


def window_classes(node):
    found = set()
    if node.get("window"):
        found.add(node.get("window_properties", {}).get("class"))
    for child in node.get("nodes", []) + node.get("floating_nodes", []):
        found.update(window_classes(child))
    return found


def process_names():
    found = set()
    for path in Path("/proc").glob("[0-9]*/comm"):
        try:
            found.add(path.read_text().strip())
        except OSError:
            pass
    return found


def make_plan(home, classes, processes):
    plan = []
    for app in APPS:
        root = home / "proot-apps" / ("ghcr.io_linuxserver_proot-apps_" + app["name"])
        launcher = home / ".local/bin" / app["launcher"]
        if app["class"] in classes or app["process"] in processes:
            reason = "already-running"
        elif not (root / "SHALAYER").is_file() or not (root / "SHALAYER").stat().st_size:
            reason = "not-installed"
        elif (root / "DOWNLOADING").exists():
            reason = "installation-in-progress"
        elif not os.access(launcher, os.X_OK):
            reason = "launcher-unavailable"
        else:
            reason = "launch"
        plan.append({"app": app["name"], "action": reason,
                     "command": [str(launcher), *app["args"]]})
    return plan


def desktop_classes():
    result = subprocess.run(["i3-msg", "-t", "get_tree"], check=True,
                            capture_output=True, text=True, timeout=2)
    return window_classes(json.loads(result.stdout))


def proxy_ready():
    try:
        with socket.create_connection(("127.0.0.1", 2080), timeout=0.5):
            return True
    except OSError:
        return False


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--dry-run", action="store_true", help="Inspect only; never launch apps")
    args = parser.parse_args()
    home = Path.home()
    if args.dry_run:
        print(json.dumps(make_plan(home, desktop_classes(), process_names()), indent=2))
        return
    state = home / ".local/state/sandbox-session"
    state.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (state / "restore.lock").open("a+") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        deadline = time.monotonic() + 20
        while True:
            try:
                classes = desktop_classes()
                break
            except (OSError, subprocess.SubprocessError, ValueError):
                if time.monotonic() >= deadline:
                    raise SystemExit("Desktop IPC not ready; no applications launched")
                time.sleep(0.25)
        plan = make_plan(home, classes, process_names())
        if any(item["action"] == "launch" for item in plan):
            deadline = time.monotonic() + 20
            while not proxy_ready() and time.monotonic() < deadline:
                time.sleep(0.25)
        with (state / "restore.log").open("a", buffering=1) as log:
            # Recheck after waiting so a manual launch cannot produce a second instance.
            for item in make_plan(home, desktop_classes(), process_names()):
                log.write(time.strftime("%Y-%m-%d %H:%M:%S ") + item["app"] + ": " + item["action"] + "\n")
                if item["action"] == "launch":
                    subprocess.Popen(item["command"], stdin=subprocess.DEVNULL,
                                     stdout=log, stderr=log, start_new_session=True)


if __name__ == "__main__":
    main()

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.example.webtop-ssh-tunnel</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/ssh</string>
		<string>-N</string>
		<string>-T</string>
		<string>-o</string>
		<string>BatchMode=yes</string>
		<string>-o</string>
		<string>StrictHostKeyChecking=yes</string>
		<string>-o</string>
		<string>ConnectTimeout=10</string>
		<string>-o</string>
		<string>ConnectionAttempts=1</string>
		<string>-o</string>
		<string>ExitOnForwardFailure=yes</string>
		<string>-o</string>
		<string>ServerAliveInterval=20</string>
		<string>-o</string>
		<string>ServerAliveCountMax=3</string>
		<string>-o</string>
		<string>ForwardAgent=no</string>
		<string>-L</string>
		<string>127.0.0.1:3001:127.0.0.1:3001</string>
		<string>sandbox-host</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/REPLACE_MAC_USER/Library/Logs/WebtopTunnel/stderr.log</string>
	<key>StandardOutPath</key>
	<string>/Users/REPLACE_MAC_USER/Library/Logs/WebtopTunnel/stdout.log</string>
	<key>ThrottleInterval</key>
	<integer>20</integer>
</dict>
</plist>

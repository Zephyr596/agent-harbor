# Copy to .env on the replica; fill the endpoint and secret. Do not commit .env.
EGRESS_SERVER_IP=REPLACE_PROXY_IPV4
EGRESS_SERVER_PORT=28443
SS_METHOD=2022-blake3-aes-128-gcm
SS_PASSWORD=REPLACE_WITH_16_BYTE_BASE64_KEY
# DNS queries are sent through the encrypted proxy, never directly.
DNS_UPSTREAM_IP=1.1.1.1
DNS_UPSTREAM_PORT=53
# Display timezone is independent of egress location.
SANDBOX_TZ=Etc/UTC
# Optional exact public-IP assertion; blank means verify a public proxy response only.
EXPECTED_EGRESS_IP=
SANDBOX_UID=1000
SANDBOX_GID=1000
FIREWALL_BASE_IMAGE=alpine@sha256:49340b346798875b5592e5d420241f2f9cfba5f47e62ebb1446a1b34734e898f
SINGBOX_IMAGE=ghcr.io/sagernet/sing-box@sha256:0788ffbddab2c68a99a2dd4780bbc50902f159af6f589df3ee74a8389d278279
WEBTOP_IMAGE=lscr.io/linuxserver/webtop@sha256:4b1607409aef6682356796fd963f91fcd5ff7e01a196aa65257b0f222d930ed3
